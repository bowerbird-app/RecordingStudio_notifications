<% skeleton_width_for = lambda do |column|
     case column.key.to_s
     when "created_at", /_at\z/
       "8rem"
     when "email"
       "70%"
     when "status"
       "5rem"
     when "action"
       "7rem"
     else
       "55%"
     end
   end %>
<% placeholder_rows = 4.times.map { |index| { placeholder_row: index } } %>

<%= wrap_recording_studio_notifications_admin_table(screen) do %>
  <div data-controller="recording-studio-admin--screen-filters">
    <div class="mb-4 flex items-center justify-between gap-3">
      <div>
        <h3 class="text-lg font-semibold text-(--surface-content-color)">Table data</h3>
        <%= turbo_frame_tag "screen-table-count" do %>
          <div class="mt-1">
            <%= render FlatPack::Skeleton::Component.new(variant: :text, width: "4rem", shimmer: true) %>
          </div>
        <% end %>
      </div>
    </div>

    <%= render FlatPack::Table::Component.new(data: placeholder_rows, class: "text-sm") do |table| %>
      <% screen.table.columns.each do |column| %>
        <% table.column(title: column.title, html: ->(_row) do
             tag.span(
               render(FlatPack::Skeleton::Component.new(variant: :text, width: skeleton_width_for.call(column), shimmer: true)),
               class: "block min-h-4",
               data: { recording_studio_admin_table_cell_skeleton: true },
               aria: { hidden: true }
             )
           end) %>
      <% end %>

      <% if screen.table.actions.any? %>
        <% table.column(title: "Actions", html: ->(_row) do
             tag.span(
               render(FlatPack::Skeleton::Component.new(variant: :text, width: "2.5rem", shimmer: true)),
               class: "block min-h-4",
               data: { recording_studio_admin_table_cell_skeleton: true },
               aria: { hidden: true }
             )
           end) %>
      <% end %>
    <% end %>
  </div>
<% end %>
