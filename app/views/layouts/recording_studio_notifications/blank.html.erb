<%
  html_attributes = { lang: I18n.locale.to_s, "data-theme" => "rounded", class: "h-full" }
  html_attributes.merge!(recording_studio_locale_attributes) if respond_to?(:recording_studio_locale_attributes)
  if respond_to?(:flat_pack_copy_data)
    html_attributes[:data] = (html_attributes[:data] || {}).merge(flat_pack_copy_data)
  end
%>
<!DOCTYPE html>
<html <%= tag.attributes(html_attributes) %>>
  <head>
    <title><%= content_for(:title) || notifications_t("layout.title") %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "flat_pack/application", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "flat_pack/variables", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "flat_pack/rich_text", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="m-0 h-screen overflow-y-auto bg-[var(--surface-page-background-color)] text-[var(--surface-content-color)]">
    <main class="mx-auto w-full max-w-6xl p-6">
      <%= yield %>
    </main>
  </body>
</html>
