<% notifications_page_heading :title, unsubscribe_title %>
<% notifications_page_heading :subtitle, unsubscribe_subtitle %>
<% flat_pack_page_nav(
     round: true,
     style: :default,
     back_href: settings_href,
     back_tooltip: notifications_t("settings.title"),
     anchor_href: settings_href,
     anchor_tooltip: notifications_t("settings.title")
   ) %>

<% if @outcome == :confirm %>
  <%= form_with url: request.fullpath, method: :post, data: { turbo: false } do %>
    <%= render FlatPack::Button::Component.new(
          text: notifications_t("unsubscribe.confirm_button"),
          style: :primary,
          size: :md,
          type: "submit"
        ) %>
  <% end %>
<% elsif @outcome == :missing %>
  <%= render FlatPack::Button::Component.new(
        text: notifications_t("unsubscribe.missing_link"),
        href: settings_href,
        style: :primary,
        size: :md
      ) %>
<% end %>
