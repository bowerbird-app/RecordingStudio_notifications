<% weight = notification.unread? ? "font-semibold" : "font-normal" %>
<% title_color = notification.unread? ? "text-(--surface-content-color)" : "text-(--surface-muted-content-color)" %>
<%= render FlatPack::List::Item.new(
  leading: notification_leading_icon(notification),
  href: open_notification_path(notification),
  hover: true,
  active: false,
  trailing: render(
    FlatPack::Timestamp::Component.new(
      timestamp: notification.created_at,
      shorten_timestamp: true,
      fallback_text: "",
      class: "text-sm #{weight} text-(--surface-muted-content-color) whitespace-nowrap"
    )
  ),
  class: "mb-0 p-6 py-6 px-6"
) do %>
  <div class="space-y-0.5 text-left">
    <div class="truncate text-sm <%= weight %> <%= title_color %>"><%= notification.title %></div>
    <% if notification.body.present? %>
      <div class="line-clamp-2 text-xs <%= weight %> text-(--surface-muted-content-color)"><%= notification.body %></div>
    <% end %>
  </div>
<% end %>
