<% notifications_page_heading :title, @notification.title %>
<% notifications_page_heading :subtitle, @notification.notification_type.humanize %>
<% flat_pack_page_nav(
     round: true,
     style: :default,
     back_href: notifications_path,
     back_tooltip: notifications_t("inbox.title"),
     anchor_href: main_app.root_path,
     anchor_tooltip: notifications_t("navigation.home")
   ) %>
<% if @notification.url.present? %>
  <% register_page_nav notifications_t("show.open_related"), @notification.url, role: :primary %>
<% end %>
<% unless @notification.archived? %>
  <% if @notification.unread? %>
    <% register_page_nav notifications_t("show.mark_read"), mark_read_notification_path(@notification), role: :secondary, data: { turbo_method: :patch } %>
  <% else %>
    <% register_page_nav notifications_t("show.mark_unread"), mark_unread_notification_path(@notification), role: :secondary, data: { turbo_method: :patch } %>
  <% end %>
<% end %>
<% if @notification.archived? %>
  <% register_page_nav notifications_t("show.unarchive"), unarchive_notification_path(@notification), role: :secondary, data: { turbo_method: :patch } %>
<% else %>
  <% register_page_nav notifications_t("show.archive"), archive_notification_path(@notification), role: :destructive, data: { turbo_method: :patch } %>
<% end %>

<% if @notification.body.present? %>
  <p class="text-sm leading-6 text-(--surface-content-color)"><%= @notification.body %></p>
<% end %>
