<% bell_label = RecordingStudioNotifications::Copy.value(
     local_assigns.fetch(:bell_label, RecordingStudioNotifications::Copy::UNSET),
     "menu.title"
   ) %>
<% empty_text = RecordingStudioNotifications::Copy.value(
     local_assigns.fetch(:empty_text, RecordingStudioNotifications::Copy::UNSET),
     "menu.empty"
   ) %>
<% if defined?(FlatPack::Notification::Component) %>
  <%= render FlatPack::Notification::Component.new(
    unread_count: unread_count,
    see_all_href: see_all_href,
    notifications: notifications,
    bell_label: bell_label,
    empty_text: empty_text,
    style: :plain,
    divider: true
  ) do |n| %>
    <% unread = n[:unread] == true || n["unread"] == true %>
    <% weight = unread ? "font-semibold" : "font-normal" %>
    <% title_color = unread ? "text-(--surface-content-color)" : "text-(--surface-muted-content-color)" %>
    <% note = notification_menu_value(n, :body) %>
    <% time = notification_menu_value(n, :time) %>
    <div class="flex w-full items-start">
      <span class="mr-2 shrink-0"><%= notification_menu_leading_icon(n) %></span>
      <div class="min-w-0 flex-1 space-y-0.5 text-left">
        <div class="truncate text-sm <%= weight %> <%= title_color %>"><%= notification_menu_value(n, :title) %></div>
        <% if note.present? %>
          <div class="line-clamp-2 text-xs <%= weight %> text-(--surface-muted-content-color)"><%= note %></div>
        <% end %>
      </div>
      <% if time.present? %>
        <span class="ml-2 shrink-0">
          <%= render FlatPack::Timestamp::Component.new(
            timestamp: time,
            tooltip_placement: :left,
            shorten_timestamp: true,
            fallback_text: "",
            class: "text-sm #{weight} text-(--surface-muted-content-color) whitespace-nowrap"
          ) %>
        </span>
      <% end %>
    </div>
  <% end %>
<% else %>
  <% label = unread_count.to_i.positive? ? RecordingStudioNotifications::Copy.t("menu.title_with_count", count: unread_count, default: "Notifications (%{count})") : bell_label %>

  <%= render FlatPack::Button::Component.new(
    text: label,
    href: see_all_href,
    style: :ghost,
    size: :md,
    icon: :bell
  ) %>
<% end %>
