<style>
  .rsn-rollup-accordion [class*="border-[var(--accordion-item-border-color)]"] {
    border-color: transparent !important;
    border-bottom-color: transparent !important;
  }

  .rsn-rollup-accordion .border-b {
    border-bottom-color: transparent !important;
  }
</style>

<% notifications_page_heading :title, notifications_t("inbox.title") %>
<% flat_pack_page_nav(
     round: true,
     style: :default,
     back_href: main_app.root_path,
     back_tooltip: notifications_t("navigation.home"),
     anchor_href: main_app.root_path,
     anchor_tooltip: notifications_t("navigation.home")
   ) %>
<% recording_studio_page_nav_right do %>
  <%= render partial: "recording_studio_notifications/notifications/title" %>
<% end %>

<div class="mx-auto flex w-full flex-col gap-6">
  <%= render FlatPack::Grid::Component.new(cols: 2, align: :start) do %>
    <%= render FlatPack::Card::Component.new(border: :strong) do |card| %>
      <% card.body do %>
        <% if @notification_sections.any? %>
          <div id="notifications-list" class="flex flex-col">
            <%= render partial: "recording_studio_notifications/notifications/page", locals: { notification_sections: @notification_sections } %>
          </div>

          <div class="pt-2">
            <%= render partial: "recording_studio_notifications/notifications/next_page", locals: { page: @page, has_next_page: @has_next_page } %>
          </div>
        <% else %>
          <p class="text-sm text-(--surface-muted-content-color)"><%= notifications_t("inbox.empty") %></p>
        <% end %>
      <% end %>
    <% end %>
  <% end %>
</div>
